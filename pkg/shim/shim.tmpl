#!{{.BashPath}}
# Shim for {{quote .BinaryName}}
# Generated by Dotfiles Management Tool

set -euo pipefail

TOOL_NAME={{quote .ToolName}}
BINARY_NAME={{quote .BinaryName}}
TOOL_EXECUTABLE={{quote .BinaryPath}}
TOOL_REQUIRES_SUDO="{{if .Sudo}}1{{else}}0{{end}}"
GENERATOR_CLI=({{if .CliEnv}}env {{quote .CliEnv}} {{end}}{{range .CliArgs}}{{quote .}} {{end}})
CONFIG_PATH={{quote .ConfigFilePath}}
USAGE_MARKER_PATH={{quote .UsageMarkerPath}}

# Prevent self-referential infinite loops
shim_self_path="${BASH_SOURCE[0]:-$0}"
if [ -n "${TOOL_EXECUTABLE:-}" ]; then
  if [ "$TOOL_EXECUTABLE" = "$shim_self_path" ] || [ "$(readlink -f "$TOOL_EXECUTABLE" 2>/dev/null)" = "$(readlink -f "$shim_self_path" 2>/dev/null)" ]; then
    echo "Error: $TOOL_NAME shim is self-referential ($TOOL_EXECUTABLE). Aborting to prevent infinite loop." >&2
    exit 1
  fi
fi

# Check for recursion
RECURSION_ENV_VAR="DOTFILES_INSTALLING_{{.EnvVarSuffix}}"

if [ -n "${!RECURSION_ENV_VAR:-}" ]; then
  echo "Recursive installation detected for $TOOL_NAME. Aborting to prevent infinite loop." >&2
  exit 1
fi

# The empty marker's modification time records the latest shim invocation.
if [ "${DOTFILES_LOCAL_USAGE_TRACKING:-1}" != "0" ]; then
  : 2>/dev/null >| "$USAGE_MARKER_PATH" || true
fi

# Check if the first argument is @update
if [ $# -gt 0 ] && [ "$1" = "@update" ]; then
  # tool update --shim-mode reports what became of the tool, so the shim adds nothing.
  "${GENERATOR_CLI[@]}" tool update --shim-mode --config "$CONFIG_PATH" "$TOOL_NAME"
  exit $?
fi

# Check if tool exists and execute it
if [ -x "$TOOL_EXECUTABLE" ]; then
  exec "$TOOL_EXECUTABLE" "$@"
else
  # Tool not found, try to install it
  if [ "$TOOL_REQUIRES_SUDO" = "1" ] && { [ ! -t 0 ] || [ ! -t 2 ]; }; then
    echo "$TOOL_NAME requires an interactive install with sudo. Run: dotfiles tool install $TOOL_NAME" >&2
    exit 1
  fi

  # Suppress dotfiles output during transparent installation in shim mode
  # Temporarily disable set -e to handle install failures gracefully
  set +e
  "${GENERATOR_CLI[@]}" tool install --shim-mode --config "$CONFIG_PATH" "$TOOL_NAME"
  install_exit_code=$?
  set -e

    if [ $install_exit_code -eq 0 ]; then
      # Installation successful, try to execute binary again
      if [ -x "$TOOL_EXECUTABLE" ]; then
        exec "$TOOL_EXECUTABLE" "$@"
      else
        {{.MissingBinaryCmd}}
        exit 1
      fi
    else
    # Installation failed, exit with the same code
    exit $install_exit_code
  fi
fi
