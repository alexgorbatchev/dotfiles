    "@typescript/native-preview": "catalog:typescript",
    "bun-plugin-tailwind": "^0.1.2",
    "dprint": "^0.51.1",
    "oxfmt": "0.42.0",
    "oxlint": "^1.57.0",
    "ts-unused": "^1.0.3",
    "tsd": "^0.33.0"
  },
  "catalog": {
    "type-fest": "^5.1.0",
    "zod": "^4.1.12",
    "tslog": "^4.10.2",
    "dax-sh": "^0.44.1"
