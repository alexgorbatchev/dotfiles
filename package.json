    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/cli.js",
      "default": "./.dist/cli.js"
    }
  },
  "scripts": {
    "typecheck": "just typecheck",
    "lint": "just lint",
    "fix": "just fix",
    "test:all": "just test",
    "test:native": "just test",
    "test:task": "just test",
    "test-project": "go run ./cmd/dotfiles --config test-project/dotfiles.config.ts",
    "compile": "just compile",
    "release": "just release",
    "cli": "go run ./cmd/dotfiles",
    "check": "just check",
    "check:ci": "just check",
    "dashboard": "just dashboard"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "5.0.2",
    "@dprint/json": "^0.21.1",
