{
  "name": "@alexgorbatchev/dotfiles",
  "version": "2.2.0",
  "private": true,
  "workspaces": [
    "packages/dashboard",
    "test-project"
  ],
  "type": "module",
  "module": "cli.ts",
  "types": "./.dist/index.d.ts",
