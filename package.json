{
  "name": "@alexgorbatchev/dotfiles",
  "version": "2.6.0",
  "private": true,
  "workspaces": [
    "packages/dashboard",
    "packages/docs",
    "test-project"
  ],
  "type": "module",
  "module": "cli.ts",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/cli.js",
      "default": "./.dist/cli.js"
    }
  },
  "scripts": {
    "typecheck": "just typecheck",
    "lint": "just lint",
    "fix": "just fix",
    "test:all": "just test",
    "test:native": "just test",
    "test:task": "just test",
    "test-project": "go run ./cmd/dotfiles --config test-project/dotfiles.config.ts",
    "compile": "just compile",
    "release": "just release",
    "cli": "go run ./cmd/dotfiles",
    "check": "just check",
    "check:ci": "just check",
    "dashboard": "just dashboard",
    "docs": "bun --cwd packages/docs build"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "5.0.3",
    "@dprint/json": "^0.24.0",
    "@dprint/markdown": "^0.24.0",
    "bun-plugin-tailwind": "^0.1.2",
    "dprint": "^0.57.4",
    "oxfmt": "0.68.0",
    "oxlint": "^1.83.0",
    "tsd": "^0.33.0",
    "typescript": "catalog:typescript"
  },
  "catalog": {
    "type-fest": "^5.10.0",
    "zod": "^4.6.5",
    "tslog": "^5.2.0",
    "dax-sh": "^0.44.1"
  },
  "catalogs": {
    "system": {
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.1",
      "@types/semver": "^7.8.0"
    },
    "testing": {
      "@rageltd/bun-test-utils": "^2.0.0"
    },
    "typescript": {
      "typescript": "^7.0.2"
    }
  }
}
