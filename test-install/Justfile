# Test installer workflow in isolated directory

# Default task: run installer
default: run

# Run installer script into .installed
run:
	@mkdir -p .installed
	@echo "Compiling..."
	@if ! out=$(cd .. && just compile 2>&1); then printf '%s\n' "$out"; exit 1; fi
	@DOTFILES_TARGET_DIR="$(pwd)/.installed/bin" \
	DOTFILES_BINARY_PATH="$(pwd)/../.dist/dotfiles" \
	DOTFILES_YES=1 \
	bash ../scripts/managed-installer/install.sh

# Clean test installation artifacts
clean:
	rm -rf .installed dotfiles.config.ts tools .generated
